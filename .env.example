# Channel IDs (right-click a channel → Copy Channel ID)
WELCOME_CHANNEL_ID=1476841525450244116
BOOST_CHANNEL_ID=980089514640945172
LEVEL_UP_CHANNEL_ID=1517942208140148919
VOICE_LOG_CHANNEL_ID=1522848739926999153
DASHBOARD_CHANNEL_ID=1519373155796389918
