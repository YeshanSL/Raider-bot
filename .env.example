# Role IDs (right-click a role in Server Settings → Copy Role ID)
BOOST_ROLE_ID=1481277937058840677
ADMIN_ROLE_ID=1476844032335417404

GUILD_ID=980089449687965726

# ─── Website live stats (optional) ───
# Your main/community server ID: the site then lists its owner + admins automatically.
# (Discord → Settings → Advanced → Developer Mode, then right-click the server icon → Copy Server ID)
STATUS_GUILD_ID=980089449687965726
# Your website address, so only your site can read /status (no trailing slash). Leave empty to allow any site.
STATUS_ORIGIN=

# ─── Database (REQUIRED) ───
# MongoDB Atlas connection string. URL-encode special characters in the password.
MONGODB_URI=
# Database name. Production data lives in "raider" (also the default if left empty).
# Do NOT change this unless you are deliberately moving to a new, empty database.
MONGODB_DB=raider

# ─── Website control panel ───
# Choose a long passkey (12+ characters). It MUST be the same one you typed in the website's set-passkey.html.
# Leave empty to turn the control panel off.
PANEL_PASSKEY=
