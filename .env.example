# Copy this file to .env and fill in your values.

# ─── Required ───
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-id-here

# Optional: set this to your server's ID while testing so slash commands
# register instantly. Leave blank to register globally (takes up to ~1hr).
GUILD_ID=

# ─── Channel IDs (optional — can also be set via /setchannel) ───
WELCOME_CHANNEL_ID=
BOOST_CHANNEL_ID=
LEVEL_UP_CHANNEL_ID=
VOICE_LOG_CHANNEL_ID=
DASHBOARD_CHANNEL_ID=

# ─── Role IDs ───
BOOST_ROLE_ID=
ADMIN_ROLE_ID=
